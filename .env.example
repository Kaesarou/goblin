# ============================================================
# GOBLIN! V3 — .env.example
# ============================================================
# Copy this file to .env, then adapt deployment-specific values.
# V3 strategy geometry, inventory risk caps, candle policy and broker safety
# are code-versioned and written to every run manifest. They are deliberately
# not mutable deployment knobs during prospective validation.
# ============================================================

# 1) Runtime / execution authority
# paper: recommended prospective collection mode; never sends trading POSTs.
# etoro_demo: may exercise the real broker mutation protocol on demo capital.
# etoro_live: intentionally rejected by the V3 bootstrap until explicit
# prospective validation and a later production-authority decision.
# alpaca_demo: experimental Alpaca paper execution; dedicated data directory required.
# alpaca_live: real Alpaca account; same V3 live-capital guard as etoro_live.
# Canonical names use underscores; alpacademo/alpacalive are accepted aliases.
BROKER=paper
LOG_LEVEL=INFO
RUNTIME_HEARTBEAT_MINUTES=5

# 2) eToro connectivity
# Used only for paper / etoro_demo / etoro_live. paper keeps eToro market data.
ETORO_API_KEY=replace_me
ETORO_USER_KEY=replace_me
ETORO_INSTRUMENT_ID_CACHE_PATH=data/etoro_instrument_ids.json

# 2b) Alpaca connectivity — used only for alpaca_demo / alpaca_live.
# Use the key/secret belonging to the account selected by BROKER.
# BROKER chooses the REST and trading WebSocket endpoints automatically.
ALPACA_API_KEY=replace_me
ALPACA_SECRET_KEY=replace_me
ALPACA_INSTRUMENT_ID_CACHE_PATH=data/alpaca_instrument_ids.json
# IEX or SIP, according to your market-data subscription; no silent fallback.
ALPACA_DATA_FEED=iex
# The durable order journal is stored beside POSITION_STORE_PATH, suffixed with
# .alpaca_demo.orders.sqlite or .alpaca_live.orders.sqlite. Do not delete it as cache.

# 3) Trading and context universe
# V3 INVENTORY_RR5_V1 currently accepts equities only. BUY is inventory/reversion
# authority; SELL alpha is not enabled. The configured benchmark symbols are
# context/research inputs, not standalone trading candidates.
# Alpaca requires only US equities in WATCHLIST and an explicit supported US
# benchmark (e.g. SPY if selected by the operator); SPX500 is never auto-mapped.
WATCHLIST=MSFT,NVDA,AAPL,AIR.PA,SAF.PA
BASE_CURRENCY=USD
CRYPTO_SYMBOLS=BTC,ETH,DOGE,SOL,XRP,ADA,LTC
EQUITY_US_SYMBOLS=MSFT,NVDA,AAPL,AMZN,META,GOOGL,TSLA
EQUITY_EU_SYMBOLS=AIR.PA,SAF.PA
MARKET_BENCHMARK_CRYPTO=Crypto10
MARKET_BENCHMARK_EQUITY_US=SPX500
MARKET_BENCHMARK_EQUITY_EU=FRA40

# 4) Trading sessions
# Session end stops new risk; V3 inventory is multi-day and is not force-closed
# merely because the local session ends.
TRADING_SESSION_TIMEZONE=Europe/Paris
TRADING_SESSIONS_CRYPTO=
TRADING_SESSIONS_EQUITY_US=15:30-22:00
TRADING_SESSIONS_EQUITY_EU=09:00-17:30

# 5) V3 risk policy
# No MAX_OPEN_POSITIONS / MAX_TRADES_PER_SESSION / BREAKEVEN_PROFILE knobs here:
# those belong to the retired V1 execution path. V3 uses its versioned RR5
# InventoryRiskConfig and strategy geometry from app/v3/config.py. Existing
# legacy fields are still parseable by Settings for historical research tools,
# but app/main.py does not use them as V3 trading authority.

# 6) Journals and persistence
APP_LOG_PATH=data/logs/goblin.log
POSITION_STORE_PATH=data/goblin.sqlite
# JOURNAL_PATH determines the parent directory used for per-run archives.
# Runtime JSONL streams are compressed under data/logs/runs/<run_id>/.
# High-volume causal restart state stays in SQLite; JSONL contains raw market,
# one finalized-candle event per M1 and compact material V3 audit events.
JOURNAL_PATH=data/logs/trades.jsonl
ERRORS_JOURNAL_PATH=data/logs/errors.jsonl
MARKET_LOG_PATH=data/logs/market.jsonl.gz
CANDLE_JOURNAL_PATH=data/logs/candles.jsonl.gz
DEBUG_DECISIONS_JOURNAL_PATH=data/logs/debug_decisions.jsonl.gz
DAILY_SUMMARY_PATH=data/logs/daily_summary.json
PARTIAL_DAILY_SUMMARY_PATH=data/logs/daily_summary.partial.json
RUN_MANIFEST_PATH=data/logs/run_manifest.json

# Read-only side-neutral research collection. It never grants V3 trade authority.
RESEARCH_ENABLED=true

# Values: minimal | normal | debug | full
# normal is recommended. V3 additionally deduplicates material decision states,
# aggregates silent decisions in heartbeats, and logs market-quality transitions
# rather than every repeated rejection.
JOURNAL_DETAIL_LEVEL=normal

# Number of per-run archive directories retained on this deployment.
JOURNAL_MAX_RUNS=30
